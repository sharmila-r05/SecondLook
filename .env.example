# Copy to .env (never committed). Every value stays on the server; only PAYPAL_CLIENT_ID may reach a browser.

# PayPal: developer dashboard → Apps & Credentials → Sandbox tab → a Merchant app linked to the US "Second Look"
# business sandbox account, with Invoicing and Payouts ticked in its features
PAYPAL_ENV=sandbox                 # the app refuses to start on anything else
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                 # from the webhook registered for APP_BASE_URL/api/paypal/webhook

# Database: a paid Postgres (Render 0.1c-256mb); never Render's free one, which is deleted mid-judging
DATABASE_URL=

APP_BASE_URL=                      # e.g. https://<service>.onrender.com, or the local tunnel URL while developing

# Claude writes the family's note on a held payment (Anthropic API key; set a hard spend cap in the Console).
# Without a key, or with a non-Claude model, the template note is used.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Voice, only if the parent's voice input uses a hosted service (browser speech needs no key)
VOICE_API_KEY=

# Demo behaviour and cost caps
DEMO_PARENT_VAULT_ID=              # optional: Margaret's saved PayPal (Vault payment token); new demo families start connected
HOLD_TIMEOUT_MINUTES=10            # demo value: a held request nobody answers is voided after this
SESSION_LLM_CALLS_CAP=60           # Claude calls per demo family (second opinion + note); then the rules alone
DAILY_LLM_CALLS_CAP=200            # AI notes per UTC day across all visitors (~$0.002 each)
DAILY_VOICE_MINUTES_CAP=

# Web push for the family's phones: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                     # mailto:<owner email>

# Signing in by email (whoever sets up a family). AUTH_SECRET signs cookies and hashes addresses: openssl rand -base64 48
AUTH_SECRET=
RESEND_API_KEY=                    # Resend, free tier; the sending domain must be verified in Resend
EMAIL_FROM=                        # e.g. Second Look <signin@mail.your-domain.com>
SESSION_EMAILS_CAP=6               # sign-in emails per demo session
ADDRESS_EMAILS_CAP=5               # per address per UTC day
DAILY_EMAILS_CAP=90                # per UTC day across all visitors (Resend's free tier allows 100)

# Optional: Render Workflows for "close the week" (inline fallback when unset)
RENDER_WORKFLOW=                   # the workflow service's slug
RENDER_WORKFLOW_API_KEY=           # a Render API key used only to start runs (POST /v1/task-runs)

# Optional: AG Studio ledger (public by design; it reaches the browser)
AG_STUDIO_LICENSE_KEY=
